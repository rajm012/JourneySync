# Copy to .env if you run services outside Docker.
# docker compose already injects these for backend/worker.
# Host-published DB ports (when using compose): Postgres 5434, Mongo 27018, Redis 6381.

DATABASE_URL=postgresql+asyncpg://journeysync:journeysync@localhost:5434/journeysync
MONGO_URL=mongodb://localhost:27018
MONGO_DB=journeysync
REDIS_URL=redis://localhost:6381

GROUND_TRUTH=./data/ground_truth.json
CUSTOMERS_PATH=./data/customers.json
DATA_DIR=./data
API=http://127.0.0.1:8000

RESOLVE_CONFIDENCE_THRESHOLD=0.6
DETERMINISTIC_THRESHOLD=0.9
